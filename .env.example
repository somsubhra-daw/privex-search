# ==========================================
# ApexSearch Engine - Environment Configuration
# ==========================================

# Server Port
PORT=3000

# Primary Search Provider Choice:
# Options: 'tavily', 'google', 'brave', 'serpapi', or 'demo'
SEARCH_PROVIDER=tavily

# ------------------------------------------
# Option 1: Tavily Search API (Default - Includes AI Summaries & Images)
# ------------------------------------------
# Get API Key: https://tavily.com/
TAVILY_API_KEY=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

# ------------------------------------------
# Option 2: Google Custom Search JSON API
# ------------------------------------------
# Get API Key: https://developers.google.com/custom-search/v1/overview
# Get CX: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CX=

# ------------------------------------------
# Option 3: Brave Search API
# ------------------------------------------
BRAVE_API_KEY=

# ------------------------------------------
# Option 4: SerpAPI
# ------------------------------------------
SERPAPI_KEY=

# ------------------------------------------
# Performance & Security Controls
# ------------------------------------------
CACHE_TTL_SECONDS=3600
RATE_LIMIT_WINDOW_MS=86400000
RATE_LIMIT_MAX_REQUESTS=3
WHITELISTED_IPS=49.37.55.94,127.0.0.1,::1,::ffff:127.0.0.1
